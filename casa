body {
  display: flex;
  justify-content: center; /* Centra horizontalmente */
  align-items: center;     /* Centra verticalmente */
  min-height: 100vh;       /* Obliga al body a medir toda la altura de la pantalla */
  margin: 0;               /* Elimina márgenes por defecto */
}


#house{
  position:relative;
  width:500px;
  height:400px;
  background-color: pink;
  border:5px solid brown;
}


#roof{
  width: 500px;
  height: 110px; 
  background-color: pink; 

  background-image: 
    repeating-linear-gradient(45deg, transparent , transparent 14px, #a0522d 15px, #a0522d 25px),
    repeating-linear-gradient(-45deg, transparent, transparent 14px, #a0522d 15px, #a0522d 25px);
  
}

#door{
    position:absolute;
  bottom:0;
  left:190px;
  width:100px;
  height: 160px;
  border:5px solid brown;
  background-color:rgb(216, 195, 157);
}

#door div{
  position:absolute;
    background-color:brown;
    border-radius: 50%;
    width:15px;
    height:15px;
   left:80px;
   top:80px;
}

#window-1{
    position:absolute;
bottom:200px;
left:40px;
width:100px;
  height: 100px;
  border:5px solid brown;
  background-color:rgb(226, 218, 218); 
    top: 170px; 
}

#window-1 div{
  position:absolute;
  border:0.4px solid brown;
  width:7px;
 height:100px;
 background-color:brown;
 left:45px;
}

#window-2{
    position:absolute;
bottom:200px;
left:340px;
  width:100px;
  height: 100px;
  border:5px solid brown;
  background-color:rgb(226, 218, 218); 
    top: 170px; 
}

#window-2 div{
  position:absolute;
  border:0.4px solid brown;
  width:7px;
 height:100px;
 background-color:brown;
 left:45px;
}

#chimney{
  position: absolute;
  top: -60px;
  left: 300px; 
  width: 80px;
  height: 100px; 
  background-color: #a3a1a1;
  z-index: -1; 
  border:2px solid black;
} 

#chimney div{
  border:1px solid black;
  padding: 5px;
  margin:0;
}

#rug{
  background-color:green;
  position:absolute;
  width:110px;
  height:40px;
  top:405px;
  left:180px;
  transform: skewX(-20deg);
}

#rug::after{
  position:absolute;
  content:"WELCOME";
  left:15px;
  top:10px;
  color:yellow;
}

#grass{
  background-color:rgb(30, 166, 30);    
  width:100%;
  height:300px;
  z-index:-1;
  bottom:0;
  position:absolute;
}

#sky{
    background-color:rgb(30, 105, 166);     
  width:100%;
  height:400px;
  z-index:-1;
  top:0;
  position:absolute;
}
